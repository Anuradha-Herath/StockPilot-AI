# ==============================================================================
# StockPilot AI — Root Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env with production credentials into git!
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockpilot_db
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot_password

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="StockPilot AI"
API_V1_PREFIX="/api/v1"

# LLM Provider Configuration
# Supported providers: 'groq', 'mock'
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
