# Application Settings
PROJECT_NAME="StockPilot AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockpilot_db

# Async Database URI for FastAPI & SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://stockpilot:stockpilot_password@localhost:5432/stockpilot_db

# Sync Database URI for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot_password@localhost:5432/stockpilot_db

# LLM Configuration (Configured for Phase 3)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
